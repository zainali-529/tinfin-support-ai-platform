{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_RUNTIME",
    "PORT",
    "WS_PORT",
    "WEB_URL",
    "WEB_APP_URL",
    "APP_URL",
    "VERCEL_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "VITE_API_URL",
    "VITE_API_WS_URL",
    "API_BASE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_KEY",
    "OPENAI_API_KEY",
    "AGENT_COPILOT_MODEL",
    "ANALYTICS_TIME_ZONE",
    "DATABASE_URL",
    "REDIS_URL",
    "ENCRYPTION_KEY",
    "ACTION_SECRET_ENCRYPTION_KEY",
    "AI_ACTION_OUTBOUND_ALLOWLIST",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "STRIPE_PRICE_STARTER",
    "STRIPE_PRICE_PRO",
    "STRIPE_PRICE_SCALE",
    "STRIPE_TRIAL_DAYS",
    "STRIPE_ENABLE_CUSTOMER_PROMO_CODES",
    "STRIPE_PLAN_COUPON_ID",
    "STRIPE_DEFAULT_COUPON_ID",
    "STRIPE_PROMOTION_CODE_ID",
    "STRIPE_DEFAULT_PROMOTION_CODE_ID",
    "VAPI_PRIVATE_KEY",
    "VAPI_PUBLIC_KEY",
    "VAPI_WEBHOOK_SECRET",
    "DEEPGRAM_API_KEY",
    "WHATSAPP_APP_SECRET",
    "MAILGUN_WEBHOOK_SIGNING_KEY",
    "NOTIFICATION_EMAIL_ENABLED",
    "NOTIFICATION_EMAIL_INCLUDE_NEW_CONVERSATIONS",
    "NOTIFICATION_RESEND_API_KEY",
    "RESEND_API_KEY",
    "NOTIFICATION_EMAIL_FROM",
    "NOTIFICATION_EMAIL_FROM_NAME",
    "NOTIFICATION_EMAIL_REPLY_TO",
    "DEMO_REQUEST_WEBHOOK_URL",
    "DEMO_REQUEST_WEBHOOK_SECRET",
    "CONTACT_REQUEST_WEBHOOK_URL",
    "CONTACT_REQUEST_WEBHOOK_SECRET",
    "ISSUE_REPORT_WEBHOOK_URL",
    "ISSUE_REPORT_WEBHOOK_SECRET",
    "ISSUE_REPORT_EMAIL_TO",
    "ISSUE_REPORT_EMAIL_FROM",
    "ISSUE_REPORT_EMAIL_FROM_NAME",
    "ISSUE_REPORT_EMAIL_REPLY_TO",
    "ISSUE_REPORT_RESEND_API_KEY",
    "SENTRY_DSN",
    "WEB_SENTRY_DSN",
    "API_SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ENABLED",
    "NEXT_PUBLIC_SENTRY_ENABLED",
    "SENTRY_ENVIRONMENT",
    "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
    "SENTRY_RELEASE",
    "NEXT_PUBLIC_APP_VERSION",
    "API_VERSION",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_UPLOAD_SOURCE_MAPS",
    "SENTRY_DEBUG_BUILD",
    "SENTRY_TUNNEL_ROUTE",
    "SENTRY_TRACES_SAMPLE_RATE",
    "NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE",
    "SENTRY_PROFILES_SAMPLE_RATE",
    "SENTRY_TEST_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
